# ========================================
# REQUIRED - Google Service Account
# ========================================
# Setup steps:
# 1. Go to https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. Create a new service account (name it anything, e.g. "calendar-kiosk")
# 3. Enable the Google Calendar API for your project
# 4. Create a JSON key for the service account: Actions → Manage keys → Add key → JSON
# 5. Download the JSON key file and copy it to this directory on the Pi
# 6. Share each Google Calendar you want displayed with the service account's email
#    address (the "client_email" field in the JSON key file).
#    Use "Make changes to events" permission to allow future event creation.
#
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json


# ========================================
# OPTIONAL - PostgreSQL Database
# ========================================
# Only needed for hosted deployments (e.g. Replit with Neon Postgres).
# When this is unset, the app automatically uses SQLite (calendar.db) which is
# the recommended setup for self-hosted Raspberry Pi installations.

# DATABASE_URL=postgresql://user:password@host:5432/dbname


# ========================================
# OPTIONAL - GitHub Repository (for auto-update)
# ========================================
# These tell the auto-updater where to look for new releases on GitHub.
# Defaults: GITHUB_REPO_OWNER=SchrodingerEQ, GITHUB_REPO_NAME=Rootboard.me
# Set these only if you fork the repo or rename it.

# GITHUB_REPO_OWNER=SchrodingerEQ
# GITHUB_REPO_NAME=Rootboard.me


# ========================================
# OPTIONAL - Weather (Open-Meteo, no API key needed)
# ========================================
# Shows a current-conditions chip in the header, hi/lo in the week view, and
# weather in the Day view. Uses https://open-meteo.com (free, no key).
# Leave WEATHER_ENABLED unset/false to hide all weather UI.
# Coordinates are treated as PII: they live only in this gitignored .env.
# Tip: use your city's coordinates rather than your exact address.

# WEATHER_ENABLED=true
# WEATHER_LAT=40.7128
# WEATHER_LON=-74.0060
# WEATHER_UNITS=celsius            # or fahrenheit
# WEATHER_LOCATION_LABEL=New York  # display name for the header chip


# ========================================
# REQUIRED - Node Environment
# ========================================
# Must be set to "production" on the Pi, otherwise the app tries to start
# the Vite dev server and fails with a "Failed to load url /src/main.tsx" error.
NODE_ENV=production
